# Lookout Theater — .env.example
#
# Nothing here is required. `npm i && npm run build && npm start` runs the full theater with zero
# configuration: keyless Esri imagery, live public feeds, the assistant off until it has a key.
# Every variable below is optional and each one unlocks exactly one capability.

# ── Where it writes (cases, scenes, recorded tracks, the aircraft registry, the watchlist) ──
# LOOKOUT_DATA_DIR=~/.lookout

# ── Photoreal 3D cities (pick one; neither = Esri World Imagery, indicator says SAT) ──
# A free Cesium ion token reaches Google's Photorealistic 3D Tiles through ion (personal use):
# CESIUM_ION_TOKEN=
# Or a Google Map Tiles API key, straight from Google (metered — restrict it to the Map Tiles API
# and to this install's origin, and set a daily quota, before setting it):
# GOOGLE_MAP_TILES_KEY=

# ── Ships (the Ships & ports layer shows the curated ports and chokepoints without this) ──
# Free at https://aisstream.io (sign up → API Keys)
# AIS_API_KEY=

# ── Scout, the assistant: any OpenAI-compatible chat endpoint and key ──
# OpenAI:      LOOKOUT_GATEWAY_URL=https://api.openai.com/v1   LOOKOUT_ASSISTANT_MODEL=<a tool-calling model>
# OpenRouter:  LOOKOUT_GATEWAY_URL=https://openrouter.ai/api/v1
# Ollama:      LOOKOUT_GATEWAY_URL=http://127.0.0.1:11434/v1   LOOKOUT_GATEWAY_KEY=ollama
# LiteLLM / your own gateway: whatever it serves at /v1/chat/completions
# LOOKOUT_GATEWAY_URL=
# LOOKOUT_GATEWAY_KEY=
# LOOKOUT_ASSISTANT_MODEL=
# Voice (push-to-talk, OpenAI Realtime) — text works without it:
# OPENAI_API_KEY=
# LOOKOUT_REALTIME_MODEL=gpt-realtime-2.1
# LOOKOUT_TRANSCRIPTION_MODEL=gpt-live-transcribe
# NEXT_PUBLIC_LOOKOUT_VOICE_USD_PER_MIN=0.30
# NEXT_PUBLIC_LOOKOUT_VOICE_MAX_MIN=20

# ── Recording your own receiver (the recorder never records a third-party feed) ──
# Point at a readsb / dump1090 / tar1090 aircraft.json — or at `node tools/fake-receiver.mjs 4631`
# to watch the recorder work without hardware (use a scratch LOOKOUT_TRACKS_DIR for that).
# LOOKOUT_RECEIVER_URL=http://127.0.0.1:8080/data/aircraft.json
# LOOKOUT_RECEIVER_LAT=
# LOOKOUT_RECEIVER_LON=
# LOOKOUT_RECORD_RADIUS_KM=300        # 0 = no radius filter
# LOOKOUT_RECORD_INTERVAL_S=5
# LOOKOUT_TRACKS_RETENTION_DAYS=30
# LOOKOUT_TRACKS_DIR=                 # default: <LOOKOUT_DATA_DIR>/tracks

# ── Watchlist alerts (a push when a watched airframe appears / reappears after 30 min) ──
# LOOKOUT_NTFY_URL=https://ntfy.sh/<your-topic>
# LOOKOUT_WATCH_DIR=                  # default: <LOOKOUT_DATA_DIR>/watch
# LOOKOUT_AIRCRAFT_DB_DIR=            # default: <LOOKOUT_DATA_DIR>/aircraft-db

# ── Who may reach this install ──
# Loopback is always admitted. Other machines on your network:
# LOOKOUT_ALLOW_LAN=1
# A public hostname, only behind Cloudflare Access (the token is verified on every request):
# LOOKOUT_PUBLIC_HOST=lookout.example.com
# LOOKOUT_CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# LOOKOUT_CF_ACCESS_AUD=
# LOOKOUT_ALLOWED_EMAILS=you@example.com

# ── Public cameras (the DOT catalogue works keyless; Windy adds thousands more) ──
# WINDY_WEBCAMS_KEY=

# ── Hosted demo build (a read-only showcase; not for a personal install) ──
# Build-time flags: sample data instead of live feeds, read-only guard, Cesium from its CDN.
# NEXT_PUBLIC_LOOKOUT_DEMO=1
# LOOKOUT_DEMO=1
# NEXT_PUBLIC_CESIUM_CDN=1
